<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon (status bar / notification shade).

  Android ignores every colour here and draws only the ALPHA channel, tinted
  with LocalNotifications' iconColor. So the artwork must be a solid
  white-on-transparent silhouette with no background plate - a filled square
  would render as a grey/accent block.

  Geometry is the app mark verbatim from public/brand/mark.svg (viewBox 0 0 49 72,
  two opposed crescents forming the spark). It is reproduced here rather than
  rescaled by hand so the two shapes stay pixel-faithful to the brand asset:
  the group transform maps the 49x72 mark into the mandatory 24x24dp canvas at
  20dp tall (scale 20/72 = 0.2777778), centred, leaving the 2dp breathing room
  the system icons use. Stroke weight lands at ~3.6dp, legible at 24dp.

  The mark is rotationally symmetric and carries no reading direction, so it
  needs no RTL mirroring (and an autoMirrored status-bar icon would be wrong).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.2777778"
        android:scaleY="0.2777778"
        android:translateX="5.1944444"
        android:translateY="2">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="nonZero"
            android:pathData="M 43.91 9.55 A 24.5 24.5 0 1 0 18.16 48.17 L 24.1 35.99 A 11.5 11.5 0 1 1 34.96 19.71 Z M 30.84 23.83 A 24.5 24.5 0 1 1 5.19 62.58 L 14.08 52.36 A 11.5 11.5 0 1 0 24.9 36.01 Z" />
    </group>
</vector>
