# Dependencies
node_modules/

# Build output
dist/

# Hidden source maps moved out of dist/ by scripts/strip-sourcemaps.mjs. They
# contain full readable source and must never be committed or published; upload
# them to Sentry for the release, then discard.
sourcemaps/

# Environment — never commit real env files; only .env.example is allowed.
.env
.env.*
!.env.example

# Netlify
.netlify

# Generated / build artifacts
coverage/
tsconfig.tsbuildinfo
tsconfig.node.tsbuildinfo
*.log
temp_debug.txt
everything-claude-code/

# Compiled output of vite.config.ts. Must never be committed: Vite resolves
# vite.config.js BEFORE vite.config.ts, so a stale checked-in .js silently
# shadows the real config for everyone.
vite.config.js
vite.config.d.ts

# Local UI preview harnesses. These live in public/, so Vite copies them into
# dist/ and they would ship as broken public pages (they link /src/**.css,
# which does not exist in a build).
public/_preview_*.html

# Program source materials — large binaries, not for git (the parsed data lives
# in src/data/bbtProgram.generated.ts + program_extracted.json instead).
857318004_The_Bodybuilding_Transformation_System_Intermediate_Advanced.pdf
sparkos video/

# AI assistant tools, skills & scratch
.kiro/
.cursor/
.claude/
.agents/
.factory/
.commandcode/
.openclaude/
.codegraph/
plugins/
skills-lock.json
.playwright-mcp/

# Playwright E2E artifacts (reports, test-results, browser cache)
playwright-report/
test-results/
/playwright/.cache/
e2e/.last-run.json

# Visual-QA screenshot output (regenerated by e2e/visual-qa.spec.ts on demand)
visual-qa/

# graphify — commit graphify-out/ (graph.json, graph.html, GRAPH_REPORT.md) for the
# team, but keep these local-only: manifest is mtime-based (breaks after clone),
# cost/cache are machine-local.
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_*
.gstack/

# KiroCrew agent memory store — auto-created inside the project, machine-local.
memory/
memory_index.db
