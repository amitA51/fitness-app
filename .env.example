# ============================================================================
# SPARKOS FITNESS - Environment Variables
# Copy this file to .env.local for local dev. Never commit real values.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (חובה)
# ----------------------------------------------------------------------------
# מ-Supabase Dashboard: Settings -> API
# בפרודקשן: לקבוע ב-Netlify Dashboard (Site settings -> Environment variables).
# אל תכניס ערכים אמיתיים לקובץ הזה — הוא מתועד ב-git.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------------------------
# Edge Function CORS allow-list
# ----------------------------------------------------------------------------
# הפונקציה ai-chat תקבל בקשות רק מ-origins ברשימה (comma-separated).
ALLOWED_ORIGIN=http://localhost:5173,https://your-site.netlify.app

# ----------------------------------------------------------------------------
# AI Provider (אופציונלי)
# ----------------------------------------------------------------------------
# מפתח ה-AI *לא* יושב כאן כי זה קובץ לקוח. הוא יושב ב-Supabase Secrets
# כדי לא להיחשף לדפדפן.
#
# הגדרה פעם אחת, מה-CLI של Supabase:
#
#   supabase secrets set OPENROUTER_API_KEY=sk-or-v1-xxxxx
#   supabase functions deploy ai-chat
#
# להחלפת מודל או ספק - ראה src/services/ai/config.ts
