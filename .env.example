# ============================================================================
# SPARKOS FITNESS - Environment Variables
# Copy this file to .env.local for local dev. Never commit real values.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (חובה)
# ----------------------------------------------------------------------------
# מ-Supabase Dashboard: Settings -> API
# בפרודקשן: לקבוע ב-Netlify Dashboard (Site settings -> Environment variables).
# אל תכניס ערכים אמיתיים לקובץ הזה — הוא מתועד ב-git.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------------------------
# Edge Function CORS allow-list
# ----------------------------------------------------------------------------
# הפונקציה ai-chat תקבל בקשות רק מ-origins ברשימה (comma-separated).
ALLOWED_ORIGIN=http://localhost:5173,https://your-site.netlify.app

# ----------------------------------------------------------------------------
# AI Provider (אופציונלי)
# ----------------------------------------------------------------------------
# מפתח ה-AI *לא* יושב כאן כי זה קובץ לקוח. הוא יושב ב-Supabase Secrets
# כדי לא להיחשף לדפדפן.
#
# הגדרה פעם אחת, מה-CLI של Supabase:
#
#   supabase secrets set POLOAI_API_KEY=sk-xxxxx
#   supabase functions deploy ai-chat
#
# להחלפת מודל או ספק - ראה src/services/ai/config.ts

# ----------------------------------------------------------------------------
# Error Tracking (Sentry)
# ----------------------------------------------------------------------------
# מפתח DSN מ-Sentry Dashboard. אופציונלי - האפליקציה תעבוד גם בלי זה.
# בפרודקשן: לקבוע ב-Netlify Dashboard.

VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------
# הפעלת bundle analyzer לבדיקת גודל החבילה. השאר ריק או 'false' בפרודקשן.

VITE_ENABLE_BUNDLE_ANALYZER=false

# ----------------------------------------------------------------------------
# Web Push (Coach reminders/messages when the app is closed) — אופציונלי
# ----------------------------------------------------------------------------
# מפתח VAPID הציבורי נחשף ללקוח (מותר). המפתח הפרטי יושב ב-Supabase Secrets בלבד.
# יצירת זוג מפתחות:  npx web-push generate-vapid-keys
#
#   supabase secrets set VAPID_PUBLIC_KEY=...  VAPID_PRIVATE_KEY=...  VAPID_SUBJECT=mailto:you@app
#   supabase functions deploy coach-push-send
#   supabase functions deploy coach-invite-accept

VITE_VAPID_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# Billing (מנוי בתשלום) — כבוי כברירת מחדל
# ----------------------------------------------------------------------------
# הדגל הזה הוא המפסק היחיד שהופך את /paywall ממסך רשימת המתנה למסך רכישה אמיתי.
# הוא לא מספיק לבדו: הרכישה תוצג רק אם קיימת גם לפחות שורה אחת פעילה ב-
# public.billing_prices (migration 20260726100000_billing_core.sql), כדי שלא
# יופיע כפתור קנייה שלא מוביל לשום מקום.
#
# רשימת ההפעלה המלאה:
#   1. לבחור ספק תשלומים ולפתוח חשבון סוחר (החלטה עסקית/משפטית — ראו
#      reports/01-MONETIZATION-BILLING.md).
#   2. supabase secrets set BILLING_PROVIDER=paddle
#      supabase secrets set PADDLE_API_KEY=... PADDLE_WEBHOOK_SECRET=...
#      supabase secrets set PADDLE_API_BASE=https://api.paddle.com
#   3. להוסיף את שורות המחיר האמיתיות ל-billing_prices (מחיר, מטבע, מע"מ,
#      תקופת ניסיון — באישור רו"ח).
#   4. supabase functions deploy billing-checkout
#      supabase functions deploy billing-webhook --no-verify-jwt
#   5. לרשום את כתובת ה-webhook אצל הספק.
#   6. VITE_BILLING_LIVE=true
#
# לאכיפת המנוי על ה-AI בצד השרת (מונע ניצול תקציב הספק ע"י משתמש חינמי):
#   supabase secrets set AI_REQUIRES_ENTITLEMENT=true

VITE_BILLING_LIVE=false

# ----------------------------------------------------------------------------
# מתג הדגמה של תצוגת המאמן — כבוי בפרודקשן כברירת מחדל
# ----------------------------------------------------------------------------
# כשהמתג פתוח, כל משתמש מחובר יכול לעבור לתצוגת המאמן, והמעבר הראשון מקדם אותו
# ל-role='coach' דרך become_coach. זה נוח להדגמה — ומסוכן בפרודקשן, כי הוא יוצר
# מאמנים חינמיים מחוץ לכל משפך מסחרי.
#
# ההתנהגות: בפיתוח (vite dev) המתג פתוח אלא אם נכתב במפורש 'false';
# ב-build של פרודקשן הוא סגור אלא אם נכתב במפורש 'true'.
# משתנה חסר לעולם אינו המצב המתירני.

VITE_DEMO_VIEW_SWITCH=false
